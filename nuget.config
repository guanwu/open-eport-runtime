<configuration>
  <packageSources>
    <add key="github-guanwu" value="https://nuget.pkg.github.com/guanwu/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="github-guanwu">
      <package pattern="eportskf" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
